# --- Database ---
DATABASE_URL=postgresql+asyncpg://agent:agent@postgres:5432/agent
DATABASE_URL_SYNC=postgresql://agent:agent@postgres:5432/agent

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- AI providers ---
# Tried in this order (see agents/providers.py:get_provider): OpenRouter ->
# Gemini -> Claude -> Ollama. Leave a key blank to skip that provider —
# Ollama needs no key so it's always available as the last resort.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=phi4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- WhatsApp ---
# mock    = no real WhatsApp, test via curl (default, safe starting point)
# baileys = real WhatsApp via the Node bridge — switch to this after you've
#           run `docker compose up baileys-bridge` and scanned the QR code
# cloud_api = official Meta API (not implemented in this Phase 1 pass)
WHATSAPP_PROVIDER=mock
WHATSAPP_ALLOWED_NUMBERS=+62812xxxxxxxx
WHATSAPP_WEBHOOK_SECRET=changeme
BAILEYS_BRIDGE_URL=http://baileys-bridge:3000

# --- Misc ---
APP_SECRET_KEY=changeme
DEBUG=true
